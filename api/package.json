{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Campus Events REST and MCP API",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "migrate": "node src/db/migrate.mjs",
    "seed": "node src/seed.mjs",
    "test": "node --env-file=.env.test --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:coverage": "node --env-file=.env.test --test --experimental-test-coverage \"tests/**/*.test.mjs\"",
    "worker:mail": "node src/workers/mail.worker.mjs",
    "test:postgres": "node --env-file=.env.postgres.test --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "amqplib": "^2.2.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
