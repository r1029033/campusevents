NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local fallback only. Production uses Neon PostgreSQL.
DB_STORAGE=./data/events.sqlite
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Generate a long random value and keep it secret.
MCP_API_KEY=

# RabbitMQ broker, for example a free CloudAMQP instance.
AMQP_URL=

# Brevo transactional email API.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Campus Events
EVENT_TIME_ZONE=Europe/Budapest
MAIL_RETRY_DELAY_MS=30000

# Optional cache. Requests remain correct when Redis is unavailable.
REDIS_URL=
