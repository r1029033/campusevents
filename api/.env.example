# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@pooled-host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/neondb?sslmode=require
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
AMQP_URL=amqp://guest:guest@localhost:5672
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Campus Events <no-reply@example.com>"
REDIS_URL=redis://127.0.0.1:6379
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Campus Events